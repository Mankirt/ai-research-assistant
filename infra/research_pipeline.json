{
  "Comment": "Multi-agent research pipeline with caching: CacheCheck -> [Research -> FactCheck -> Write -> Critique -> SaveResult]",
  "StartAt": "CacheCheck",
  "States": {
    "CacheCheck": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:513616570472:function:ai-cache-check",
      "Next": "IsCached",
      "ResultSelector": {
        "cache_hit.$": "$.cache_hit",
        "body.$": "$.body"
      },
      "ResultPath": "$.cacheResult"
    },
    "IsCached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.cacheResult.cache_hit",
          "BooleanEquals": true,
          "Next": "ReturnCached"
        }
      ],
      "Default": "Research"
    },
    "ReturnCached": {
      "Type": "Pass",
      "InputPath": "$.cacheResult.body",
      "End": true
    },
    "Research": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:513616570472:function:ai-researcher-agent",
      "InputPath": "$.cacheResult.body",
      "Next": "FactCheck",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "body.$": "$.body"
      },
      "ResultPath": "$.researchResult"
    },
    "FactCheck": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:513616570472:function:ai-fact-checker-agent",
      "InputPath": "$.researchResult.body",
      "Next": "Write",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "body.$": "$.body"
      },
      "ResultPath": "$.factCheckResult"
    },
    "Write": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:513616570472:function:ai-writer-agent",
      "InputPath": "$.factCheckResult.body",
      "Next": "Critique",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "body.$": "$.body"
      },
      "ResultPath": "$.writerResult"
    },
    "Critique": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:513616570472:function:ai-critic-agent",
      "InputPath": "$.writerResult.body",
      "Next": "SaveResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "body.$": "$.body"
      },
      "ResultPath": "$.critiqueResult"
    },
    "SaveResult": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:513616570472:function:ai-save-result",
      "InputPath": "$.critiqueResult.body",
      "End": true,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "body.$": "$.body"
      }
    }
  }
}